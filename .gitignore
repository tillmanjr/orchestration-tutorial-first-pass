node_modules/
target/
*.log
.DS_Store
Thumbs.db

# Superseded by .donotdelete markers; the mount forbids deletion, so they are
# ignored rather than removed. Delete them on a machine with write access.
.gitkeep

# Generated data and benchmark scratch are ignored, but the directories
# themselves are kept. A bare "data/" would stop git descending into the
# directory at all, and the marker would never survive a clone.
data/*
!data/.donotdelete
bench-out/*
!bench-out/.donotdelete

# Per-machine benchmark opt-in. MUST NOT be committed: if this travelled with
# the repo every host would declare itself admissible, including the agent
# sandbox E8 forbids -- which would restore exactly the failure the marker
# exists to prevent. Each machine creates its own.
.benchmark-host

# Files the mount would not let an agent delete. Contents are staged for
# manual removal, not for version control.
_to_delete/
